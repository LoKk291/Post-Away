{
    "manifest_version": 3,
    "name": "Post-Away Extension",
    "version": "1.0",
    "description": "Se conecta a Post-Away para rellenar campos de Patreon automáticamente.",
    "permissions": ["activeTab"],
    "host_permissions": ["*://*.patreon.com/*", "http://127.0.0.1:3333/*"],
    "content_scripts": [
        {
            "matches": ["*://*.patreon.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
